                <box>
                    <bottomPen lineWidth="1.5" lineColor="#4F6AF0"/>
                </box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <paragraph leftIndent="6"/>
                </textElement>
                <text><![CDATA[TELÉFONO]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="415" y="0" width="120" height="24"
                    uuid="55555555-5555-5555-5555-555555555555"/>
                <box>
                    <bottomPen lineWidth="1.5" lineColor="#4F6AF0"/>
                </box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <paragraph leftIndent="6"/>
                </textElement>
                <text><![CDATA[DIRECCIÓN]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- DETALLE -->

    <detail>
        <band height="24">

            <frame>
                <reportElement style="Row" x="0" y="0" width="535" height="24"
                    uuid="66666666-6666-6666-6666-666666666666"/>

                <textField>
                    <reportElement style="Cell" x="0" y="0" width="90" height="24"
                        uuid="77777777-7777-7777-7777-777777777777"/>
                    <box>
                        <bottomPen lineWidth="0.5" lineColor="#E8E8E8"/>
                    </box>
                    <textElement verticalAlignment="Middle">
