<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
 name="ReporteEstudiantes" language="groovy"
 pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20"
 uuid="c1e1fa57-3f36-4d58-8b72-bdaa1ae71953">

    <!-- ESTILOS -->

    <style name="Title" fontName="DejaVu Sans" fontSize="18" isBold="false"
           forecolor="#1A1A1A"/>

    <style name="Subtitle" fontName="DejaVu Sans" fontSize="9" isBold="false"
           forecolor="#999999"/>

    <style name="Header" fontName="DejaVu Sans" fontSize="9" isBold="true"
           mode="Opaque" backcolor="#FFFFFF" forecolor="#888888"/>

    <style name="Cell" fontName="DejaVu Sans" fontSize="10" forecolor="#2C2C2C"/>

    <style name="Row">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
            <style backcolor="#F4F6F8" mode="Opaque"/>
        </conditionalStyle>
    </style>

    <!-- QUERY -->

    <queryString language="SQL"><![CDATA[
        SELECT cedula, nombre, apellido, telefono, direccion
        FROM estudiantes;
    ]]></queryString>

    <field name="cedula"    class="java.lang.String"/>
    <field name="nombre"    class="java.lang.String"/>
    <field name="apellido"  class="java.lang.String"/>
    <field name="telefono"  class="java.lang.String"/>
    <field name="direccion" class="java.lang.String"/>

    <!-- TÍTULO -->

    <title>
        <band height="64">

            <rectangle>
                <reportElement x="0" y="8" width="3" height="34"
                    forecolor="#4F6AF0" backcolor="#4F6AF0"
                    uuid="a1b2c3d4-0001-0001-0001-000000000001"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement style="Title" x="12" y="8" width="523" height="24"
                    uuid="a1b2c3d4-0002-0002-0002-000000000002"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <text><![CDATA[Reporte de Estudiantes]]></text>
            </staticText>

            <staticText>
                <reportElement style="Subtitle" x="12" y="34" width="523" height="14"
                    uuid="a1b2c3d4-0003-0003-0003-000000000003"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <text><![CDATA[Listado general · Sistema de Gestión Académica]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="62" width="535" height="1"
                    forecolor="#E0E0E0"
                    uuid="a1b2c3d4-0004-0004-0004-000000000004"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>

        </band>
    </title>

    <!-- CABECERA TABLA -->

    <columnHeader>
        <band height="28">

            <staticText>
                <reportElement style="Header" x="0" y="0" width="90" height="24"
                    uuid="11111111-1111-1111-1111-111111111111"/>
                <box>
                    <bottomPen lineWidth="1.5" lineColor="#4F6AF0"/>
                </box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <paragraph leftIndent="6"/>
                </textElement>
                <text><![CDATA[CÉDULA]]></text>
