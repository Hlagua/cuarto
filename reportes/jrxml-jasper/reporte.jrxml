<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
 name="ReporteEstudiantes" language="groovy"
 pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20"
 uuid="c1e1fa57-3f36-4d58-8b72-bdaa1ae71953">

    <!-- =====================================================
         ESTILOS
    ====================================================== -->

    <style name="Title" fontName="DejaVu Sans" fontSize="22" isBold="true"
           forecolor="#222222"/>

    <style name="Header" fontName="DejaVu Sans" fontSize="11" isBold="true"
           mode="Opaque" backcolor="#2D2D2D" forecolor="#FFFFFF"/>

    <style name="Cell" fontName="DejaVu Sans" fontSize="11" forecolor="#333333"/>

    <style name="Row">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
            <style backcolor="#F8F8F8" mode="Opaque"/>
        </conditionalStyle>
    </style>

    <!-- =====================================================
         QUERY
    ====================================================== -->

    <queryString language="SQL"><![CDATA[
        SELECT cedula, nombre, apellido, telefono, direccion
        FROM estudiantes;
    ]]></queryString>

    <field name="cedula" class="java.lang.String"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="apellido" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>
    <field name="direccion" class="java.lang.String"/>

    <!-- =====================================================
         TITULO
    ====================================================== -->

    <title>
        <band height="60">
            <staticText>
                <reportElement style="Title" x="0" y="10" width="535" height="40"
                    uuid="5c5b7f0e-2432-4ff5-b07d-2c6ea29028a6"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Reporte de los Estudiantes]]></text>
            </staticText>
        </band>
    </title>

    <!-- =====================================================
         CABECERA TABLA (COLUMNAS)
    ====================================================== -->

    <columnHeader>
        <band height="26">
            <staticText>
                <reportElement style="Header" x="0" y="0" width="90" height="26"
                    uuid="11111111-1111-1111-1111-111111111111"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <paragraph leftIndent="6"/>
                </textElement>
                <text><![CDATA[Cédula]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="90" y="0" width="115" height="26"
                    uuid="22222222-2222-2222-2222-222222222222"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <paragraph leftIndent="6"/>
                </textElement>
                <text><![CDATA[Nombre]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="205" y="0" width="115" height="26"
                    uuid="33333333-3333-3333-3333-333333333333"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <paragraph leftIndent="6"/>
                </textElement>
                <text><![CDATA[Apellido]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="320" y="0" width="95" height="26"
                    uuid="44444444-4444-4444-4444-444444444444"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <paragraph leftIndent="6"/>
                </textElement>
                <text><![CDATA[Teléfono]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="415" y="0" width="120" height="26"
                    uuid="55555555-5555-5555-5555-555555555555"/>
                <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <paragraph leftIndent="6"/>
                </textElement>
                <text><![CDATA[Dirección]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- =====================================================
         DETALLE (FILAS)
    ====================================================== -->

    <detail>
        <band height="24">

            <frame>
                <reportElement style="Row" x="0" y="0" width="535" height="24"
                    uuid="66666666-6666-6666-6666-666666666666"/>

                <textField>
                    <reportElement style="Cell" x="0" y="0" width="90" height="24"
                        uuid="77777777-7777-7777-7777-777777777777"/>
                    <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                    <textElement verticalAlignment="Middle">
                        <paragraph leftIndent="6"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{cedula}]]></textFieldExpression>
                </textField>

                <textField>
                    <reportElement style="Cell" x="90" y="0" width="115" height="24"
                        uuid="88888888-8888-8888-8888-888888888888"/>
                    <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                    <textElement verticalAlignment="Middle">
                        <paragraph leftIndent="6"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
                </textField>

                <textField>
                    <reportElement style="Cell" x="205" y="0" width="115" height="24"
                        uuid="99999999-9999-9999-9999-999999999999"/>
                    <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                    <textElement verticalAlignment="Middle">
                        <paragraph leftIndent="6"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{apellido}]]></textFieldExpression>
                </textField>

                <textField>
                    <reportElement style="Cell" x="320" y="0" width="95" height="24"
                        uuid="aaaaaaa1-aaaa-aaaa-aaaa-aaaaaaaaaaa1"/>
                    <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                    <textElement verticalAlignment="Middle">
                        <paragraph leftIndent="6"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression>
                </textField>

                <textField>
                    <reportElement style="Cell" x="415" y="0" width="120" height="24"
                        uuid="bbbbbbb1-bbbb-bbbb-bbbb-bbbbbbbbbbb1"/>
                    <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                    <textElement verticalAlignment="Middle">
                        <paragraph leftIndent="6"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{direccion}]]></textFieldExpression>
                </textField>

            </frame>

        </band>
    </detail>

</jasperReport>
